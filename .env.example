# App
PORT=3000
NODE_ENV=production

# Auth — required when NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
LOGIN_PIN=112233
# Override passcodes must differ from LOGIN_PIN in production
MANUAL_MIXED_TYPE_PASSCODE=445566
MANUAL_WEIGHT_OVERRIDE_PASSCODE=778899

# Set to true only behind HTTPS (e.g. production reverse proxy)
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Caddy, etc.)
TRUST_PROXY=false

# Database (DB_HOST=db when running via Docker Compose)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=matching_secret
DB_NAME=matching_db

# Matching — auto-match entry spacing (recent fights window)
AUTO_MATCH_ENTRY_GAP=5

# Link with the betting station (same server): fights are called here, results come back.
# Generate each key with: openssl rand -hex 32 (the same two keys go in the betting station's .env).
BETTING_BRIDGE_ENABLED=false
# Betting station as seen from this container (shared docker network "arena-bridge").
BETTING_BRIDGE_URL=http://sabonglara-app
MATCHING_TO_BETTING_KEY=
BETTING_TO_MATCHING_KEY=
