<%- include('../layouts/header') %>
<div class="page-heading">
  <div>
    <h1 class="h3 mb-1">Reset & Backup</h1>
    <p class="text-muted mb-0">Back up the database and clear all event data when starting fresh.</p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="panel h-100">
      <h2 class="h5">1. Backup Only</h2>
      <p class="text-muted small">Create a SQL snapshot without changing any data. Use this before an event or before risky changes.</p>
      <form method="post" action="/reset/backup">
        <button type="submit" class="btn btn-outline-primary w-100">
          <i class="bi bi-download"></i> Create Backup Now
        </button>
      </form>
    </section>
  </div>

  <div class="col-lg-4">
    <section class="panel h-100 border border-danger">
      <h2 class="h5 text-danger">2. Reset All Data</h2>
      <p class="text-muted small">
        <strong>Step A:</strong> automatic database backup<br>
        <strong>Step B:</strong> clear events, owners, entries, gamecocks, matches, scores, and TV state
      </p>
      <form id="resetForm" method="post" action="/reset">
        <label class="form-label">Type <code>RESET</code> to confirm</label>
        <input required name="confirmation" id="resetConfirmation" class="form-control mb-3" autocomplete="off" placeholder="RESET">
        <button type="submit" class="btn btn-danger w-100">
          <i class="bi bi-exclamation-triangle"></i> Backup & Clear All Data
        </button>
      </form>
    </section>
  </div>

  <div class="col-lg-4">
    <section class="panel h-100">
      <h2 class="h5">3. Restore Backup</h2>
      <p class="text-muted small">Replace the current database with a previous backup. A safety backup is created first.</p>
      <% if (backups.length) { %>
        <form method="post" action="/reset/restore">
          <label class="form-label">Backup file</label>
          <select required name="backup_file" class="form-select mb-3">
            <% backups.forEach((backup) => { %>
              <option value="<%= backup.filename %>">
                <%= backup.filename %> (<%= Math.ceil(backup.size / 1024) %> KB)
              </option>
            <% }) %>
          </select>
          <label class="form-label">Type <code>RESET</code> to confirm</label>
          <input required name="confirmation" class="form-control mb-3" autocomplete="off" placeholder="RESET">
          <button class="btn btn-primary w-100">Restore Selected Backup</button>
        </form>
      <% } else { %>
        <div class="text-muted">No backups yet. Create one first using step 1 or run a reset.</div>
      <% } %>
    </section>
  </div>
</div>

<section class="panel mt-4">
  <div class="panel-header">
    <h2 class="h5 mb-0">Available Backups</h2>
    <span class="text-muted small"><%= backups.length %> file<%= backups.length === 1 ? '' : 's' %> in ./backups</span>
  </div>
  <% if (backups.length) { %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Filename</th>
            <th>Size</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% backups.forEach((backup) => { %>
            <tr>
              <td><code><%= backup.filename %></code></td>
              <td><%= Math.ceil(backup.size / 1024) %> KB</td>
              <td><%= new Date(backup.created_at).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-muted mb-0">Backups appear here after you create one or run a reset.</p>
  <% } %>
</section>

<section class="panel mt-4" style="max-width: 760px;">
  <h2 class="h5 mb-3">Upload and Restore SQL Backup</h2>
  <div id="uploadRestoreAlert" class="alert d-none"></div>
  <p class="text-muted small">Upload a `.sql` file from your computer. The system creates a safety backup first, then restores the uploaded file.</p>

  <form id="uploadRestoreForm">
    <label class="form-label">SQL backup file</label>
    <input required type="file" id="backupUploadFile" class="form-control mb-3" accept=".sql,application/sql,text/plain">

    <label class="form-label">Type <code>RESET</code> to confirm</label>
    <input required id="backupUploadConfirmation" class="form-control mb-3" autocomplete="off" placeholder="RESET">
    <button id="uploadRestoreButton" class="btn btn-primary" type="submit">Upload and Restore Backup</button>
  </form>
</section>

<div class="modal fade" id="resetConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">Confirm Reset</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>This will:</p>
        <ol class="mb-0">
          <li>Create a full SQL backup in <code>backups/</code></li>
          <li>Delete all events, owners, entries, gamecocks, matches, and scores</li>
        </ol>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="resetConfirmButton">Backup & Clear All Data</button>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const resetForm = document.getElementById('resetForm');
    const resetModal = document.getElementById('resetConfirmModal');
    const resetConfirmButton = document.getElementById('resetConfirmButton');
    let resetModalInstance = null;

    if (resetForm && resetModal && window.bootstrap) {
      resetModalInstance = new bootstrap.Modal(resetModal);
      resetForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (document.getElementById('resetConfirmation').value.trim() !== 'RESET') {
          resetForm.reportValidity();
          return;
        }
        resetModalInstance.show();
      });
      resetConfirmButton.addEventListener('click', () => {
        resetConfirmButton.disabled = true;
        resetForm.submit();
      });
    }

    const form = document.getElementById('uploadRestoreForm');
    if (!form) return;

    const alertBox = document.getElementById('uploadRestoreAlert');
    const fileInput = document.getElementById('backupUploadFile');
    const confirmationInput = document.getElementById('backupUploadConfirmation');
    const button = document.getElementById('uploadRestoreButton');

    function showAlert(type, message) {
      alertBox.className = `alert alert-${type}`;
      alertBox.textContent = message;
      alertBox.classList.remove('d-none');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const file = fileInput.files[0];
      const confirmation = confirmationInput.value.trim();
      if (!file) {
        showAlert('warning', 'Select a SQL backup file first.');
        return;
      }
      if (confirmation !== 'RESET') {
        showAlert('danger', 'Type RESET to confirm.');
        return;
      }
      if (!window.confirm('Restore this uploaded backup now? A safety backup will be created first.')) return;

      button.disabled = true;
      showAlert('info', 'Uploading and restoring backup. Please wait...');

      try {
        const response = await fetch(`/reset/restore-upload?confirmation=${encodeURIComponent(confirmation)}`, {
          method: 'POST',
          headers: {
            'Content-Type': file.type || 'application/sql',
            'X-Backup-Filename': file.name
          },
          body: file
        });
        const payload = await response.json();
        if (!payload.ok) {
          showAlert('danger', payload.message || 'Unable to restore uploaded backup.');
          return;
        }

        showAlert('success', payload.message);
        fileInput.value = '';
        confirmationInput.value = '';
        setTimeout(() => window.location.reload(), 1200);
      } catch (error) {
        showAlert('danger', 'Unable to restore uploaded backup.');
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>
<%- include('../layouts/footer') %>
