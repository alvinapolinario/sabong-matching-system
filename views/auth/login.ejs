<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= appName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body class="login-body">
  <main class="login-shell">
    <form action="/login" method="post" class="login-card">
      <input type="hidden" name="return_to" value="<%= returnTo %>">
      <h1>Cockpit Matching</h1>
      <p>Enter the 6-digit PIN to continue.</p>
      <% if (error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>
      <label class="form-label">PIN Code</label>
      <input
        required
        autofocus
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        name="pin"
        type="password"
        class="form-control form-control-lg pin-input"
        autocomplete="current-password"
      >
      <button class="btn btn-dark btn-lg w-100 mt-3">Login</button>
    </form>
  </main>
</body>
</html>
