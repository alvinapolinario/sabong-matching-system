<%- include('layouts/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Event registration, entry encoding, and fight matching overview.</p>
  </div>
  <a href="/matching" class="btn btn-dark"><i class="bi bi-intersect"></i> Open Matching Board</a>
</div>

<div class="row g-3 mb-4">
  <% [
    ['Events', stats.events, 'bi-calendar-event'],
    ['Owners', stats.owners, 'bi-people'],
    ['Entries', stats.entries, 'bi-card-checklist'],
    ['Available', stats.available, 'bi-check-circle'],
    ['Active Matches', stats.active_matches, 'bi-trophy']
  ].forEach((card) => { %>
    <div class="col-6 col-lg">
      <div class="card stat-card">
        <div class="card-body">
          <div class="text-muted small"><i class="bi <%= card[2] %>"></i> <%= card[0] %></div>
          <div class="display-6 fw-semibold"><%= card[1] %></div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<section class="panel mb-4">
  <div class="panel-header">
    <h2 class="h5 mb-0">Data Management</h2>
    <a href="/reset" class="btn btn-sm btn-outline-danger">Open Reset & Backup</a>
  </div>
  <div class="row g-3 align-items-center">
    <div class="col-md-8">
      <p class="mb-2 text-muted small">
        Reset creates an automatic SQL backup first, then clears all events, owners, entries, gamecocks, matches, and scores.
      </p>
      <% if (latestBackup) { %>
        <div class="small">Latest backup: <code><%= latestBackup.filename %></code> · <%= new Date(latestBackup.created_at).toLocaleString() %></div>
      <% } else { %>
        <div class="small text-muted">No backups yet.</div>
      <% } %>
    </div>
    <div class="col-md-4 d-flex gap-2 justify-content-md-end">
      <form method="post" action="/reset/backup" class="m-0">
        <button type="submit" class="btn btn-outline-primary btn-sm">Backup Now</button>
      </form>
      <a href="/reset" class="btn btn-danger btn-sm">Reset All Data</a>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="panel">
      <div class="panel-header">
        <h2 class="h5 mb-0">Recent Events</h2>
        <a href="/events/new" class="btn btn-sm btn-outline-dark">New Event</a>
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Status</th></tr></thead>
          <tbody>
            <% events.forEach((event) => { %>
              <tr>
                <td><%= event.event_name %></td>
                <td><%= event.event_date %></td>
                <td><%= event.venue %></td>
                <td><span class="badge text-bg-secondary"><%= event.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="panel">
      <div class="panel-header">
        <h2 class="h5 mb-0">Latest Matches</h2>
        <a href="/fights" class="btn btn-sm btn-outline-dark">Fight Schedule</a>
      </div>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Fight</th><th>MERON</th><th>WALA</th><th>Diff</th></tr></thead>
          <tbody>
            <% matches.forEach((match) => { %>
              <tr>
                <td>#<%= match.fight_no %><% if (match.marker_suffix) { %><span class="match-marker"><%= match.marker_suffix %></span><% } %></td>
                <td><%= match.meron_owner %> / <%= match.meron_weight %>g</td>
                <td><%= match.wala_owner %> / <%= match.wala_weight %>g</td>
                <td><%= match.weight_difference %>g</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('layouts/footer') %>
